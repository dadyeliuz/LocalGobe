+fn object_has_mouse_listeners<'gc>(obj: DisplayObject<'gc>) -> bool {
+    use crate::avm2::object::TObject;
+    if let Some(stage_obj) = obj.object2() {
+        if let crate::avm2::Value::Object(dispatch_val) =
+            stage_obj.get_slot(crate::avm2::globals::slots::flash_events_event_dispatcher::DISPATCH_LIST)
+        {
+            if let Some(dispatch_obj) = dispatch_val.as_dispatch_object() {
+                if dispatch_obj.has_mouse_listeners() {
+                    return true;
+                }
+            }
+        }
+    }
+    false
+}
+
+fn tree_has_mouse_listeners<'gc>(obj: DisplayObject<'gc>) -> bool {
+    if object_has_mouse_listeners(obj) {
+        return true;
+    }
+    if let Some(container) = obj.as_container() {
+        for child in container.iter_render_list() {
+            if tree_has_mouse_listeners(child) {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+fn should_skip_dragged_object<'gc>(
+    obj: DisplayObject<'gc>,
+    context: &UpdateContext<'gc>,
+) -> bool {
+    if let Some(ref drag_object) = *context.drag_object {
+        if is_dragged_or_descendant(obj, drag_object.display_object) {
+            // Dragged display objects that listen to mouse events (e.g. crosshair targeting reticles)
+            // are interactive targets and must participate in mouse picking.
+            if tree_has_mouse_listeners(drag_object.display_object) {
+                return false;
+            }
+
+            let is_pressed_drag = context
+                .mouse_data
+                .pressed
+                .map(|p| is_dragged_or_descendant(p.as_displayobject(), drag_object.display_object))
+                .unwrap_or(false);
+            return !is_pressed_drag;
+        }
+    }
+    false
+}
