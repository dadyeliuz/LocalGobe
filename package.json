{
  "name": "localgobe",
  "version": "0.1.0-preview.2",
  "private": true,
  "type": "module",
  "description": "Preservation-oriented local launcher and server emulator for user-provided Mogobe copies.",
  "license": "MIT",
  "main": "dist-desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:frontend": "tsc --noEmit && vite build",
    "build:desktop": "node --experimental-strip-types scripts/build-desktop.ts",
    "manifest:release": "node --experimental-strip-types scripts/generate-release-manifest.ts",
    "build": "npm run build:frontend && npm run build:desktop",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "smoke-test": "electron . --smoke-test",
    "audit:public": "node --experimental-strip-types scripts/audit-public.ts",
    "audit:release": "node --experimental-strip-types scripts/audit-release.ts",
    "setup:ruffle": "node --experimental-strip-types scripts/setup-ruffle.ts",
    "acquire:ruffle": "node --experimental-strip-types scripts/acquire-ruffle.ts",
    "build:air-shims": "node --experimental-strip-types scripts/build-air-shims.ts",
    "setup:fonts": "node --experimental-strip-types scripts/setup-fonts.ts",
    "package:dir": "electron-builder --dir",
    "package:win": "electron-builder --win --publish never",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "electron-updater": "6.8.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.localgobe.launcher",
    "productName": "LocalGobe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/runtime",
        "to": "runtime",
        "filter": [
          "ruffle/**/*",
          "air/**/*",
          "fonts/**/*"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "ruffle/LICENSE_MIT",
        "to": "LICENSE_MIT_RUFFLE"
      },
      {
        "from": "ruffle/LICENSE_APACHE",
        "to": "LICENSE_APACHE_RUFFLE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "LocalGobe-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "dadyeliuz",
      "repo": "LocalGobe"
    }
  }
}
